# Mawqie-Web configuration example. Copy to `.env` and fill in locally.
# This file contains NO real secrets. Values below are placeholders.
#
# The server reads configuration from process.env only. It does not load `.env`
# automatically (no dotenv dependency); export the variables or use your process
# manager / shell. See README.md "Configuration".
#
# NOTE: this build ships staging-only components (JSON/in-memory store, mock
# payments, unverified remote license adapter). Production startup is refused by
# design until real infrastructure exists. See README "Production strictness".

# --- Runtime ---
NODE_ENV=development
PORT=3000
# Public base URL. MUST be https:// in production.
BASE_URL=http://localhost:3000
# Set to 1 when running behind a trusted reverse proxy that sets X-Forwarded-Proto.
TRUST_PROXY=0
# Cookie Secure flag. Defaults to true in production, false otherwise.
COOKIE_SECURE=0

# --- Secrets (REQUIRED in production; random ephemeral values are used in dev) ---
# 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=
WEBHOOK_SECRET=

# --- Admin (REQUIRED in production) ---
ADMIN_EMAIL=admin@example.test
# scrypt hash produced by `npm run hash-password -- "your-password"` (see README).
ADMIN_PASSWORD_HASH=

# --- Licensing (server-side only; signing key never reaches the client) ---
LICENSE_MODE=local
# local  -> this server signs entitlement envelopes itself
# remote -> delegate issuance to an existing license backend (adapter seam)
LICENSE_BACKEND_URL=
# PEM-encoded EC P-256 private key. REQUIRED in production when LICENSE_MODE=local.
LICENSE_PRIVATE_KEY_PEM=
# Issuer/audience MUST match the host app's GPSLabLicenseIssuer / GPSLabLicenseAudience
# (Source/GPSLabLicenseBuildConfig.h defaults to `GPSLab` / `GPSLab-iOS`).
LICENSE_ISSUER=GPSLab
LICENSE_AUDIENCE=GPSLab-iOS
# Pin: base64 SPKI of the host app's embedded GPSLabLicensePublicKey.
# local  -> startup fails unless the configured signing key's public key matches.
# remote -> every envelope returned by the backend is verified against this key
#           (a bad signature is rejected); without it only the shape is checked.
LICENSE_EXPECTED_PUBLIC_KEY=
# Offline grace window granted on issued licenses (seconds).
LICENSE_GRACE_SECONDS=604800

# --- Payments ---
# Mock provider is for local/staging only. MUST be 0 in production.
ALLOW_MOCK_PAYMENTS=1

# --- Notifications ---
# Comma-separated channels: console, file. (Email delivery is an adapter seam.)
NOTIFY_CHANNELS=console
NOTIFY_EMAIL_FROM=no-reply@mawqie.test

# --- Data / rate limits ---
DATA_FILE=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
