# GPSLab build outputs and local tooling caches.
# Only generated artifacts are ignored here; Source/ and docs are always tracked.

# Theos build products
.theos/
build/
*.dylib
*.zip

# Object files / archives / symbols
*.o
*.a
*.dSYM/
*.swiftmodule

# Local packages and tooling
packages/
scripts/tmp/

# Python tooling caches (scripts/*.py)
__pycache__/
*.pyc

# Generated CI release reports: uploaded as CI artifacts, never committed.
# (RELEASE_PROTECTION_REPORT.md is the tracked baseline; the .ci.md variant and
# the production report are generated from the actual build on each run.)
GPSLab-production-report.json
GPSLab-production-report.md
RELEASE_PROTECTION_REPORT.ci.md

# Editor / OS noise
.DS_Store
Thumbs.db
*~
*.swp
